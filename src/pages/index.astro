---
import Layout from '../layouts/Layout.astro';
import TimeConverter from '../components/TimeConverter';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { homepageConverterLinks, homepageGuideLinks } from '../lib/seoPages';

const pageTitle = 'Time Zone Converter - Convert Time Zones Instantly | timetz';
const pageDescription =
  'Free time zone converter for UTC, IST, EST, PST, GMT, and city-to-city scheduling. Type 4pm Mumbai to London and get the right time instantly.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'timetz',
      alternateName: 'timetz.com',
      description: pageDescription,
      url: 'https://www.timetz.com/',
    },
    {
      '@type': 'WebApplication',
      name: 'timetz Time Zone Converter',
      description: pageDescription,
      url: 'https://www.timetz.com/',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  {jsonLd}
>
  <header class="app-header">
    <div class="app-header-inner">
      <a href="/" class="app-logo-link">
        <img src="/favicon-96x96.png" width="96" height="96" alt="timetz logo" class="app-logo-img" />
        <span class="app-logo-text">timetz</span>
      </a>
      <span class="app-tagline">Convert any timezone instantly</span>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark">
        <span class="theme-icon-dark">🌙</span>
        <span class="theme-icon-light">☀️</span>
      </button>
    </div>
  </header>

  <main id="converter">
    <h1 class="sr-only">Free Time Zone Converter</h1>
    <TimeConverter client:load />
  </main>

  <section class="popular-converters" aria-labelledby="popular-converters-title">
    <div class="popular-converters-inner">
      <div class="popular-converters-copy">
        <span class="section-eyebrow">Popular converters</span>
        <h2 id="popular-converters-title">Common time zone conversions</h2>
        <p>
          Open the most requested timetz converters directly, with DST-aware city
          cards and natural language input ready to use.
        </p>
      </div>

      <div class="popular-converters-grid">
        {homepageConverterLinks.map(({ href, label, description }) => (
          <a href={href} class="popular-converter-card">
            <span>{label}</span>
            <small>{description}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seo-guides" aria-labelledby="seo-guides-title">
    <div class="seo-guides-inner">
      <div class="popular-converters-copy">
        <span class="section-eyebrow">Time guides</span>
        <h2 id="seo-guides-title">Timezone guides for scheduling and logs</h2>
        <p>
          Learn the rules behind UTC, GMT, daylight saving, Eastern Time, and Unix timestamps.
        </p>
      </div>

      <div class="seo-guides-grid">
        {homepageGuideLinks.map(({ href, label, description }) => (
          <a href={href} class="popular-converter-card">
            <span>{label}</span>
            <small>{description}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <About />
  <Contact />
  <Footer />
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .app-tagline {
    margin-left: auto;
    font-size: 13px;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-weight: 500;
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, #50e3c2, #007cf0, #7928ca);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .section-eyebrow {
    display: block;
    margin-bottom: 8px;
    color: var(--color-mute);
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .popular-converters,
  .seo-guides {
    background: var(--color-canvas);
    padding: 56px 24px 72px;
    border-top: 1px solid var(--color-hairline);
  }

  .seo-guides {
    padding-top: 0;
  }

  .popular-converters-inner,
  .seo-guides-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 32px;
    align-items: start;
  }

  .popular-converters-copy h2 {
    margin: 8px 0 12px;
    color: var(--color-ink);
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.04em;
  }

  .popular-converters-copy p {
    margin: 0;
    color: var(--color-body);
    font-size: 14px;
    line-height: 24px;
  }

  .popular-converters-grid,
  .seo-guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .popular-converter-card {
    display: flex;
    min-height: 118px;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    background: var(--color-canvas-soft);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: var(--shadow-level-1);
    transition: border-color 0.15s, transform 0.15s, background 0.15s;
  }

  .popular-converter-card:hover {
    border-color: var(--color-cyan);
    background: var(--color-canvas-soft-2);
    transform: translateY(-1px);
  }

  .popular-converter-card span {
    font-size: 15px;
    font-weight: 700;
    line-height: 20px;
  }

  .popular-converter-card small {
    color: var(--color-body);
    font-size: 13px;
    line-height: 20px;
  }

  @media (max-width: 920px) {
    .popular-converters-inner,
    .seo-guides-inner {
      grid-template-columns: 1fr;
    }

    .popular-converters-grid,
    .seo-guides-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .popular-converters,
    .seo-guides {
      padding: 40px 16px 52px;
    }

    .seo-guides {
      padding-top: 0;
    }

    .popular-converters-grid,
    .seo-guides-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = saved || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);

    document.addEventListener('DOMContentLoaded', function () {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    });
  })();
</script>
