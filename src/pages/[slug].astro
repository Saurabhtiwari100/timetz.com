---
import Layout from '../layouts/Layout.astro';
import TimeConverter from '../components/TimeConverter';
import Footer from '../components/Footer.astro';
import { seoPages } from '../lib/seoPages';
import type { ConverterSeoPage, SeoPage } from '../lib/seoPages';

type TableRow = {
  source: string;
  targets: string[];
};

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const page = Astro.props.page as SeoPage;
const converterPage = page.kind === 'converter' ? page : undefined;
const guidePage = page.kind === 'guide' ? page : undefined;

const defaultCities = converterPage
  ? [converterPage.sourceCity, ...converterPage.targetCities]
  : guidePage?.defaultCities ?? ['UTC', 'Mumbai', 'London', 'New York'];

const allCities = defaultCities.join(',');
const pageUrl = new URL(`/${page.slug}`, Astro.site ?? 'https://www.timetz.com').toString();

function formatClock(totalMinutes: number) {
  const dayShift = Math.floor(totalMinutes / 1440);
  const normalizedMinutes = ((totalMinutes % 1440) + 1440) % 1440;
  const hour24 = Math.floor(normalizedMinutes / 60);
  const minute = normalizedMinutes % 60;
  const period = hour24 >= 12 ? 'PM' : 'AM';
  const hour12 = hour24 % 12 || 12;
  const time = `${hour12}:${String(minute).padStart(2, '0')} ${period}`;

  if (dayShift === -1) return `${time} (prev day)`;
  if (dayShift === 1) return `${time} (next day)`;
  if (dayShift < -1) return `${time} (${Math.abs(dayShift)} days prior)`;
  if (dayShift > 1) return `${time} (+${dayShift} days)`;
  return time;
}

function buildTableRows(source: ConverterSeoPage): TableRow[] {
  return Array.from({ length: 24 }, (_, hour) => {
    const sourceMinutes = hour * 60;
    return {
      source: formatClock(sourceMinutes),
      targets: source.tableTargets.map(({ offsetMinutes }) => formatClock(sourceMinutes + offsetMinutes)),
    };
  });
}

const tableRows = converterPage ? buildTableRows(converterPage) : [];

const schemaBase =
  page.kind === 'converter'
    ? {
        '@type': 'WebApplication',
        name: page.h1,
        description: page.description,
        url: pageUrl,
        applicationCategory: 'UtilityApplication',
        operatingSystem: 'Any',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      }
    : {
        '@type': 'Article',
        headline: page.h1,
        description: page.description,
        url: pageUrl,
        author: { '@type': 'Organization', name: 'timetz' },
        publisher: { '@type': 'Organization', name: 'timetz' },
      };

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    schemaBase,
    {
      '@type': 'FAQPage',
      mainEntity: page.faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: a,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Time Zone Converter',
          item: 'https://www.timetz.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: page.h1,
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<Layout title={page.title} description={page.description} canonicalPath={`/${page.slug}`} {jsonLd}>
  <header class="app-header">
    <div class="app-header-inner">
      <a href="/" class="app-logo-link">
        <img src="/favicon-96x96.png" width="96" height="96" alt="timetz logo" class="app-logo-img" />
        <span class="app-logo-text">timetz</span>
      </a>
      <span class="app-tagline">Convert any timezone instantly</span>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark">
        <span class="theme-icon-dark">🌙</span>
        <span class="theme-icon-light">☀️</span>
      </button>
    </div>
  </header>

  <main>
    <div class="slug-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Time Zone Converter</a>
        <span aria-hidden="true">/</span>
        <span>{page.h1}</span>
      </nav>
      <span class="page-chip">{page.kind === 'converter' ? 'Converter' : 'Guide'}</span>
      <h1 class="slug-h1">{page.h1}</h1>
      <p class="slug-intro">{page.intro}</p>
    </div>

    <TimeConverter client:load defaultCities={allCities} />

    {converterPage && (
      <>
        <section class="slug-section" aria-labelledby="conversion-table-title">
          <div class="section-heading">
            <span class="section-eyebrow">24-hour table</span>
            <h2 id="conversion-table-title">{converterPage.navLabel} conversion table</h2>
            <p>{converterPage.tableNote}</p>
          </div>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>{converterPage.tableSourceLabel}</th>
                  {converterPage.tableTargets.map(({ label }) => (
                    <th>{label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {tableRows.map((row) => (
                  <tr>
                    <td>{row.source}</td>
                    {row.targets.map((target) => (
                      <td>{target}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="slug-section slug-two-col" aria-label="Timezone planning notes">
          <div>
            <span class="section-eyebrow">DST notes</span>
            <h2>Daylight saving notes</h2>
            <ul class="seo-list">
              {converterPage.dstNotes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </div>
          <div>
            <span class="section-eyebrow">Meeting window</span>
            <h2>Best meeting time</h2>
            <p>{converterPage.meetingWindow}</p>
          </div>
        </section>
      </>
    )}

    {guidePage && (
      <>
        <section class="slug-section" aria-labelledby="takeaways-title">
          <div class="section-heading">
            <span class="section-eyebrow">Quick answer</span>
            <h2 id="takeaways-title">Key takeaways</h2>
          </div>
          <ul class="takeaway-list">
            {guidePage.keyTakeaways.map((takeaway) => (
              <li>{takeaway}</li>
            ))}
          </ul>
        </section>

        <section class="guide-body" aria-label={`${guidePage.h1} guide`}>
          {guidePage.sections.map((section) => (
            <article class="guide-section">
              <h2>{section.heading}</h2>
              <p>{section.body}</p>
              {section.bullets && (
                <ul class="seo-list">
                  {section.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>

        {guidePage.codeExamples && guidePage.codeExamples.length > 0 && (
          <section class="slug-section code-examples" aria-labelledby="code-examples-title">
            <div class="section-heading">
              <span class="section-eyebrow">Developer examples</span>
              <h2 id="code-examples-title">Code examples for epoch time conversion</h2>
              <p>Copy a snippet and replace the timestamp or time zone with the values you need.</p>
            </div>
            <div class="code-examples-grid">
              {guidePage.codeExamples.map((example, index) => {
                const codeId = `code-example-${page.slug}-${index}`;
                return (
                  <article class="code-example">
                    <div class="code-example-header">
                      <div>
                        <h3>{example.title}</h3>
                        <p>{example.description}</p>
                      </div>
                      <button
                        type="button"
                        class="code-copy-btn"
                        data-code-copy
                        data-code-target={codeId}
                        aria-label={`Copy ${example.title} code example`}
                      >
                        Copy
                      </button>
                    </div>
                    <pre><code id={codeId} class={`language-${example.language}`}>{example.code}</code></pre>
                  </article>
                );
              })}
            </div>
          </section>
        )}
      </>
    )}

    <section class="slug-faq">
      <h2>Frequently Asked Questions</h2>
      {page.faq.map(({ q, a }) => (
        <div class="faq-item">
          <h3>{q}</h3>
          <p>{a}</p>
        </div>
      ))}
    </section>

    <nav class="slug-related">
      <span>{page.kind === 'converter' ? 'Related converters:' : 'Related pages:'}</span>
      {page.related.map(({ href, label }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
  </main>

  <Footer />
</Layout>

<style>
  .slug-hero {
    max-width: 860px;
    margin: 40px auto 0;
    padding: 0 24px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 16px;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .breadcrumbs a {
    color: var(--color-link);
    text-decoration: none;
  }

  .breadcrumbs a:hover { text-decoration: underline; }

  .page-chip,
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .page-chip {
    margin-bottom: 12px;
  }

  .slug-h1 {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 750;
    margin: 0 0 12px;
    color: var(--color-text-primary);
    letter-spacing: 0;
  }

  .slug-intro {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 32px;
  }

  .slug-section,
  .guide-body,
  .slug-faq {
    max-width: 860px;
    margin: 48px auto 0;
    padding: 0 24px;
  }

  .section-heading {
    max-width: 720px;
    margin-bottom: 18px;
  }

  .section-heading h2,
  .slug-section h2,
  .guide-section h2,
  .slug-faq h2 {
    color: var(--color-text-primary);
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.3;
    margin: 8px 0 10px;
  }

  .section-heading p,
  .slug-section p,
  .guide-section p,
  .faq-item p {
    color: var(--color-text-secondary);
    font-size: 0.94rem;
    line-height: 1.7;
    margin: 0;
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    background: var(--color-canvas-soft);
  }

  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-hairline);
    padding: 10px 14px;
    text-align: left;
    white-space: nowrap;
  }

  th {
    color: var(--color-text-primary);
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  td {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  tr:last-child td { border-bottom: none; }

  .slug-two-col {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 28px;
  }

  .seo-list,
  .takeaway-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
    color: var(--color-text-secondary);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .takeaway-list {
    padding: 18px 20px 18px 38px;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    background: var(--color-canvas-soft);
  }

  .guide-body {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .guide-section {
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .guide-section:last-child { border-bottom: none; }

  .guide-section h2 {
    margin-top: 0;
  }

  .guide-section .seo-list {
    margin-top: 14px;
  }

  .code-examples-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .code-example {
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    background: var(--color-canvas-soft);
  }

  .code-example-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    padding: 16px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .code-example h3 {
    color: var(--color-text-primary);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    margin: 0 0 6px;
  }

  .code-example p {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0;
  }

  .code-copy-btn {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--color-hairline);
    border-radius: 9999px;
    background: var(--color-canvas-soft);
    color: var(--color-text-primary);
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .code-copy-btn:hover,
  .code-copy-btn:focus-visible {
    border-color: var(--color-link);
    background: var(--color-canvas);
    outline: none;
  }

  .code-copy-btn[data-copied='true'] {
    border-color: var(--color-link);
    color: var(--color-link);
  }

  .code-example pre {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.22);
  }

  .code-example code {
    color: var(--color-text-primary);
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.82rem;
    line-height: 1.65;
    white-space: pre;
  }

  .slug-faq h2 {
    margin-bottom: 24px;
  }

  .faq-item {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .faq-item:last-child { border-bottom: none; }

  .faq-item h3 {
    font-size: 0.95rem;
    font-weight: 650;
    margin: 0 0 8px;
    color: var(--color-text-primary);
  }

  .slug-related {
    max-width: 860px;
    margin: 40px auto 60px;
    padding: 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .slug-related a {
    padding: 6px 14px;
    border: 1px solid var(--color-hairline);
    border-radius: 20px;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background 0.15s;
  }

  .slug-related a:hover { background: var(--color-canvas-soft); }

  @media (max-width: 760px) {
    .slug-two-col {
      grid-template-columns: 1fr;
    }

    .slug-section,
    .guide-body,
    .slug-faq,
    .slug-related,
    .slug-hero {
      padding-left: 16px;
      padding-right: 16px;
    }

    .code-example-header {
      flex-direction: column;
      align-items: stretch;
    }

    .code-copy-btn {
      width: fit-content;
    }
  }
</style>

<script is:inline>
  (function () {
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
    document.addEventListener('DOMContentLoaded', function () {
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', function () {
          const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        });
      }

      document.querySelectorAll('[data-code-copy]').forEach(function (copyButton) {
        copyButton.addEventListener('click', async function () {
          const codeId = copyButton.getAttribute('data-code-target');
          const code = codeId ? document.getElementById(codeId) : null;
          const text = code ? code.textContent || '' : '';
          if (!text) return;

          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(text);
            } else {
              const textarea = document.createElement('textarea');
              textarea.value = text;
              textarea.setAttribute('readonly', '');
              textarea.style.position = 'fixed';
              textarea.style.top = '-1000px';
              document.body.appendChild(textarea);
              textarea.select();
              const execCopy = document['exec' + 'Command'];
              const didCopy = typeof execCopy === 'function' ? execCopy.call(document, 'copy') : false;
              document.body.removeChild(textarea);
              if (!didCopy) throw new Error('Copy command failed');
            }
            const originalText = copyButton.textContent || 'Copy';
            copyButton.textContent = 'Copied';
            copyButton.setAttribute('data-copied', 'true');
            window.setTimeout(function () {
              copyButton.textContent = originalText;
              copyButton.removeAttribute('data-copied');
            }, 1800);
          } catch {
            copyButton.textContent = 'Copy failed';
            window.setTimeout(function () {
              copyButton.textContent = 'Copy';
            }, 1800);
          }
        });
      });
    });
  })();
</script>
